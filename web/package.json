{
  "name": "gpt-live-speaker",
  "version": "0.1.0",
  "private": true,
  "description": "Full-duplex voice conversations with OpenAI gpt-live-1 in the browser.",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/gpt-live-speaker",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "check:types": "svelte-check --fail-on-warnings",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "knip": "^6.39.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "ultracite": "^7.12.2",
    "vite": "^8.3.2"
  },
  "packageManager": "bun@1.4.2"
}
